{
  "name": "quotapeek",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "scripts": {
    "test": "node --test tests/frontend/*.test.cjs",
    "check": "tsc --noEmit && tsc --project tsconfig.node.json --noEmit --tsBuildInfoFile node_modules/.cache/tsconfig.node.tsbuildinfo && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build:portable": "tauri build --no-bundle",
    "tauri:build:installed": "tauri build --config src-tauri/tauri.installed.conf.json --features installed",
    "tauri:software": "tauri dev --config src-tauri/tauri.software-rendering.conf.json",
    "tauri:build:software": "tauri build --config src-tauri/tauri.software-rendering.conf.json",
    "tauri:diagnose": "node scripts/diagnose-rendering.cjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@tauri-apps/api": "~2.12.0",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "@tauri-apps/cli": "^2.12.1"
  }
}
